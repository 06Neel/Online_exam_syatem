# Copy this file to .env and fill in the values.
# .env is ignored by git (.gitignore) - never commit real secrets.

# ---------------------------------------------------------------- database
# Postgres connection string. Antideploy sets this AUTOMATICALLY (it provisions
# a free Postgres database as soon as it sees `pg` in package.json) - nothing to
# do on that host. Leave it EMPTY for local development: the app then keeps all
# data in server/data/ as plain files.
# Any Postgres works too, e.g. Neon free tier:
#   postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------- admin
# The hidden administrator sign-in lives ONLY here, never in the database.
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# ---------------------------------------------------------------- first run
# Optional: create one teacher account on the very first run (never again
# after that, and it never overwrites an existing account).
SEED_TEACHER_ID=teacher
SEED_TEACHER_PASSWORD=

# ---------------------------------------------------------------- optional
# Where private data lives when not using the database. Default: server/data
# DATA_DIR=
# SESSION_MAX_AGE_HOURS=12
